Sub FindComfyCandidates(byRef found)
    Dim roots, i, p, cfgs
    roots = Array(sh.ExpandEnvironmentStrings("%USERPROFILE%\ComfyUI"), sh.ExpandEnvironmentStrings("%USERPROFILE%\Documents\ComfyUI"), sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\ComfyUI"), sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\Comfy-Desktop\ComfyUI-Installs"), sh.ExpandEnvironmentStrings("%APPDATA%\ComfyUI"), "C:\ComfyUI", "D:\ComfyUI")
    For i = 0 To UBound(roots)
        AddCandidate found, CStr(roots(i))
        ScanForComfy found, CStr(roots(i)), 3
    Next
    cfgs = Array(sh.ExpandEnvironmentStrings("%APPDATA%\ComfyUI\settings.json"), sh.ExpandEnvironmentStrings("%APPDATA%\ComfyUI\config.json"), sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\ComfyUI\settings.json"), sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\ComfyUI\config.json"))
    For i = 0 To UBound(cfgs)
        AddDesktopConfigCandidates found, CStr(cfgs(i))
    Next
End Sub

Sub AddDesktopConfigCandidates(byRef found, cfg)
    Dim text, rx, matches, m, value
    If Not fso.FileExists(cfg) Then Exit Sub
    On Error Resume Next
    text = fso.OpenTextFile(cfg, 1, False).ReadAll
    On Error GoTo 0
    Set rx = CreateObject("VBScript.RegExp")
    rx.Global = True
    rx.IgnoreCase = True
    rx.Pattern = """(?:basePath|comfyuiPath|installationPath)""\s*:\s*""([^""]+)"""
    Set matches = rx.Execute(text)
    For Each m In matches
        value = Replace(CStr(m.SubMatches(0)), "\\", "\")
        AddCandidate found, value
        AddCandidate found, value & "\ComfyUI"
    Next
End Sub

Sub ScanForComfy(byRef found, root, depth)
    Dim folder, child
    If depth < 0 Or Not fso.FolderExists(root) Then Exit Sub
    AddCandidate found, root
    On Error Resume Next
    Set folder = fso.GetFolder(root)
    For Each child In folder.SubFolders
        If LCase(child.Name) = "comfyui" Then AddCandidate found, child.Path
        If depth > 0 Then ScanForComfy found, child.Path, depth - 1
    Next
    On Error GoTo 0
End Sub

Sub AddCandidate(byRef found, path)
    Dim normalized
    normalized = ValidateComfyRoot(path)
    If normalized <> "" Then
        If Not found.Exists(LCase(normalized)) Then found.Add LCase(normalized), normalized
    End If
End Sub

Function ValidateComfyRoot(path)
    ValidateComfyRoot = ""
    If path = "" Or Not fso.FolderExists(path) Then Exit Function
    If fso.FolderExists(path & "\custom_nodes") And fso.FileExists(path & "\main.py") Then
        ValidateComfyRoot = fso.GetAbsolutePathName(path)
        Exit Function
    End If
    If fso.FolderExists(path & "\ComfyUI\custom_nodes") And fso.FileExists(path & "\ComfyUI\main.py") Then
        ValidateComfyRoot = fso.GetAbsolutePathName(path & "\ComfyUI")
    End If
End Function

Function ChooseComfyRoot(found)
    Dim keys, i, msg, answer, selected
    ChooseComfyRoot = ""
    If found.Count = 0 Then
        MsgBox "No valid ComfyUI installation was found automatically. Select the folder that contains ComfyUI's main.py and custom_nodes folder.", 48, "KIE Nodes Next " & VERSION
        selected = BrowseForFolder()
        ChooseComfyRoot = ValidateComfyRoot(selected)
        If ChooseComfyRoot = "" Then MsgBox "That folder is not a valid ComfyUI installation. Nothing was installed.", 16, "KIE Nodes Next"
        Exit Function
    End If
    If found.Count = 1 Then
        ChooseComfyRoot = found.Items()(0)
        Exit Function
    End If
    keys = found.Items
    msg = "More than one valid ComfyUI installation was found:" & vbCrLf & vbCrLf
    For i = 0 To found.Count - 1
        msg = msg & (i + 1) & ". " & keys(i) & vbCrLf
    Next
    msg = msg & vbCrLf & "Enter the number to install into, or Cancel to choose a folder."
    answer = InputBox(msg, "Choose ComfyUI installation", "1")
    If answer = "" Then
        selected = BrowseForFolder()
        ChooseComfyRoot = ValidateComfyRoot(selected)
    ElseIf IsNumeric(answer) Then
        i = CInt(answer) - 1
        If i >= 0 And i < found.Count Then ChooseComfyRoot = keys(i)
    End If
    If ChooseComfyRoot = "" Then MsgBox "No valid ComfyUI installation was selected. Nothing was installed.", 48, "KIE Nodes Next"
End Function

Function BrowseForFolder()
    Dim folder
    BrowseForFolder = ""
    Set folder = app.BrowseForFolder(0, "Select the ComfyUI folder (contains main.py and custom_nodes)", 0)
    If Not folder Is Nothing Then BrowseForFolder = folder.Self.Path
End Function

Function IsComfyRunning()
    Dim svc, procs, p, n, cmd
    IsComfyRunning = False
    On Error Resume Next
    Set svc = GetObject("winmgmts:\\.\root\cimv2")
    Set procs = svc.ExecQuery("SELECT Name, CommandLine FROM Win32_Process")
    For Each p In procs
        n = LCase(CStr(p.Name & ""))
        cmd = LCase(CStr(p.CommandLine & ""))
        If n = "comfyui.exe" Or (n = "python.exe" And InStr(cmd, "comfyui") > 0) Then IsComfyRunning = True
    Next
    On Error GoTo 0
End Function

Function QuarantineKieCopies(customPath, backupPath)
    Dim folder, child, name, count
    count = 0
    If Not fso.FolderExists(customPath) Then
        QuarantineKieCopies = count
        Exit Function
    End If
    Set folder = fso.GetFolder(customPath)
    For Each child In folder.SubFolders
        name = LCase(child.Name)
        If name = LCase(PACKAGE_NAME) Or InStr(name, "kie-nodes-next") > 0 Or InStr(name, "kie_nodes_next") > 0 Then
            fso.MoveFolder child.Path, backupPath & "\" & child.Name & "-" & count
            count = count + 1
        End If
    Next
    QuarantineKieCopies = count
End Function

Function ExtractZip(sourceZip, destination)
    Dim zipNs, destNs, started, deadline
    ExtractZip = False
    On Error Resume Next
    Set zipNs = app.NameSpace(sourceZip)
    Set destNs = app.NameSpace(destination)
    If zipNs Is Nothing Or destNs Is Nothing Then Exit Function
    destNs.CopyHere zipNs.Items, 16
    deadline = DateAdd("n", 2, Now)
    Do While Now < deadline
        If fso.FolderExists(destination & "\" & PACKAGE_NAME) Then
            If fso.FileExists(destination & "\" & PACKAGE_NAME & "\__init__.py") Then
                ExtractZip = True
                Exit Function
            End If
        End If
        WScript.Sleep 250
    Loop
    On Error GoTo 0
End Function

Function VerifyInstalled(root)
    Dim initText, nodesText
    VerifyInstalled = False
    If Not fso.FileExists(root & "\__init__.py") Or Not fso.FileExists(root & "\nodes\__init__.py") Then Exit Function
    initText = fso.OpenTextFile(root & "\__init__.py", 1, False).ReadAll
    nodesText = fso.OpenTextFile(root & "\nodes\__init__.py", 1, False).ReadAll
    If InStr(initText, "__version__ = """ & VERSION & """") = 0 Then Exit Function
    If InStr(nodesText, "KIE_Next_Any_API_Request") > 0 Then Exit Function
    VerifyInstalled = True
End Function

Function InstallDependencies(root, packagePath)
    Dim pythonExe, code
    InstallDependencies = ""
    pythonExe = FindComfyPython(root)
    If pythonExe = "" Then Exit Function
    code = sh.Run(Chr(34) & pythonExe & Chr(34) & " -m pip install --disable-pip-version-check -r " & Chr(34) & packagePath & "\requirements.txt" & Chr(34), 0, True)
    If code <> 0 Then InstallDependencies = vbCrLf & vbCrLf & "Dependency check returned code " & code & "."
End Function

Function FindComfyPython(root)
    Dim parent, candidates, item
    FindComfyPython = ""
    parent = fso.GetParentFolderName(root)
    candidates = Array(root & "\.venv\Scripts\python.exe", root & "\venv\Scripts\python.exe", parent & "\python_embeded\python.exe", root & "\python_embeded\python.exe")
    For Each item In candidates
        If fso.FileExists(CStr(item)) Then FindComfyPython = CStr(item): Exit Function
    Next
End Function

Function WriteBase64File(data, path)
    Dim xml, node, stream
    WriteBase64File = False
    On Error Resume Next
    Set xml = CreateObject("MSXML2.DOMDocument.6.0")
    Set node = xml.createElement("b64")
    node.DataType = "bin.base64"
    node.Text = data
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 1
    stream.Open
    stream.Write node.nodeTypedValue
    stream.SaveToFile path, 2
    stream.Close
    WriteBase64File = (Err.Number = 0)
    On Error GoTo 0
End Function

Sub EnsureFolder(path)
    Dim parent
    If fso.FolderExists(path) Then Exit Sub
    parent = fso.GetParentFolderName(path)
    If parent <> "" And Not fso.FolderExists(parent) Then EnsureFolder parent
    If Not fso.FolderExists(path) Then fso.CreateFolder path
End Sub

Sub WriteRepairReport(path, root, targetPath, moved)
    Dim out
    Set out = fso.CreateTextFile(path, True)
    out.WriteLine "KIE Nodes Next " & VERSION & " installation report"
    out.WriteLine "Validated ComfyUI root: " & root
    out.WriteLine "Installed path: " & targetPath
    out.WriteLine "Quarantined old KIE folders: " & moved
    out.WriteLine "Verification: version " & VERSION & " present; legacy Any API registration absent"
    out.Close
End Sub

Function TimeStamp()
    Dim d
    d = Now
    TimeStamp = Year(d) & Right("0" & Month(d), 2) & Right("0" & Day(d), 2) & "-" & Right("0" & Hour(d), 2) & Right("0" & Minute(d), 2) & Right("0" & Second(d), 2)
End Function

Sub Fail(message)
    MsgBox message, 16, "KIE Nodes Next " & VERSION
    WScript.Quit 1
End Sub
