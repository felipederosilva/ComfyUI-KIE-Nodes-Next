Function IsComfyRunning()
    Dim svc, procs, p, n, cmd
    IsComfyRunning = False
    On Error Resume Next
    Set svc = GetObject("winmgmts:\\.\root\cimv2")
    Set procs = svc.ExecQuery("SELECT Name, CommandLine FROM Win32_Process")
    For Each p In procs
        n = LCase(CStr(p.Name & ""))
        cmd = LCase(CStr(p.CommandLine & ""))
        If n = "comfyui.exe" Then
            IsComfyRunning = True
            Exit Function
        End If
        If (n = "python.exe" Or n = "pythonw.exe") And InStr(cmd, "comfyui") > 0 And InStr(cmd, "main.py") > 0 Then
            IsComfyRunning = True
            Exit Function
        End If
    Next
    On Error GoTo 0
End Function

Function DetectComfyRoot()
    Dim candidate, configPath, text, re, matches, basePath, candidates, item
    DetectComfyRoot = ""
    configPath = sh.ExpandEnvironmentStrings("%APPDATA%") & "\ComfyUI\config.json"
    If fso.FileExists(configPath) Then
        On Error Resume Next
        text = fso.OpenTextFile(configPath, 1, False).ReadAll
        Set re = New RegExp
        re.Pattern = """basePath""\s*:\s*""([^""]+)"""
        re.IgnoreCase = True
        Set matches = re.Execute(text)
        If matches.Count > 0 Then
            basePath = matches(0).SubMatches(0)
            basePath = Replace(basePath, "\\", "\")
            candidate = NormalizeComfyRoot(basePath)
            If candidate <> "" Then
                DetectComfyRoot = candidate
                Exit Function
            End If
        End If
        On Error GoTo 0
    End If

    candidates = Array( _
        sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\ComfyUI", _
        sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\Documents\ComfyUI", _
        sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\Desktop\ComfyUI", _
        sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\ComfyUI_windows_portable\ComfyUI", _
        sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\Downloads\ComfyUI_windows_portable\ComfyUI", _
        "C:\ComfyUI", _
        "C:\ComfyUI_windows_portable\ComfyUI", _
        "D:\ComfyUI", _
        "D:\ComfyUI_windows_portable\ComfyUI" _
    )
    For Each item In candidates
        candidate = NormalizeComfyRoot(CStr(item))
        If candidate <> "" Then
            DetectComfyRoot = candidate
            Exit Function
        End If
    Next
End Function

Function NormalizeComfyRoot(path)
    NormalizeComfyRoot = ""
    If path = "" Then Exit Function
    If fso.FolderExists(path & "\custom_nodes") Then
        NormalizeComfyRoot = path
        Exit Function
    End If
    If fso.FolderExists(path & "\ComfyUI\custom_nodes") Then NormalizeComfyRoot = path & "\ComfyUI"
End Function

Function PickComfyRoot()
    Dim folder, path, normalized
    PickComfyRoot = ""
    Set folder = app.BrowseForFolder(0, "Select the ComfyUI folder that contains custom_nodes (or the outer ComfyUI_windows_portable folder).", 0, 0)
    If folder Is Nothing Then Exit Function
    On Error Resume Next
    path = folder.Self.Path
    On Error GoTo 0
    normalized = NormalizeComfyRoot(path)
    If normalized <> "" Then PickComfyRoot = normalized
End Function

Function IsKieNextFolder(folderObj)
    Dim n, marker, txt
    IsKieNextFolder = False
    n = LCase(folderObj.Name)
    If n = "comfyui-kie-nodes-next" Or n = "kie-ai-nodes-next" Then
        IsKieNextFolder = True
        Exit Function
    End If
    If Left(n, Len("comfyui-kie-nodes-next.backup-")) = "comfyui-kie-nodes-next.backup-" Then
        IsKieNextFolder = True
        Exit Function
    End If
    If Left(n, Len("kie-ai-nodes-next.backup-")) = "kie-ai-nodes-next.backup-" Then
        IsKieNextFolder = True
        Exit Function
    End If
    marker = folderObj.Path & "\nodes\__init__.py"
    If fso.FileExists(marker) Then
        On Error Resume Next
        txt = fso.OpenTextFile(marker, 1, False).ReadAll
        On Error GoTo 0
        If InStr(txt, "KIE_Next_Connection_Status") > 0 And InStr(txt, "KIE_Next_Universal_Task") > 0 Then IsKieNextFolder = True
    End If
End Function

Function QuarantineKieNextCopies(customNodesPath, safeBackupRoot)
    Dim rootFolder, subFolder, paths(), count, i, dest, suffix
    count = 0
    Set rootFolder = fso.GetFolder(customNodesPath)
    For Each subFolder In rootFolder.SubFolders
        If IsKieNextFolder(subFolder) Then
            ReDim Preserve paths(count)
            paths(count) = subFolder.Path
            count = count + 1
        End If
    Next
    For i = 0 To count - 1
        dest = safeBackupRoot & "\" & fso.GetFileName(paths(i))
        suffix = 1
        Do While fso.FolderExists(dest)
            dest = safeBackupRoot & "\" & fso.GetFileName(paths(i)) & "-" & suffix
            suffix = suffix + 1
        Loop
        On Error Resume Next
        fso.MoveFolder paths(i), dest
        If Err.Number <> 0 Then
            MsgBox "Could not quarantine an old KIE Next copy:" & vbCrLf & paths(i) & vbCrLf & vbCrLf & Err.Description, 16, "KIE Nodes Next"
            WScript.Quit 5
        End If
        On Error GoTo 0
    Next
    QuarantineKieNextCopies = count
End Function

Function VerifyV031(root)
    Dim initText, nodesText
    VerifyV031 = False
    If Not fso.FileExists(root & "\__init__.py") Then Exit Function
    If Not fso.FileExists(root & "\nodes\__init__.py") Then Exit Function
    On Error Resume Next
    initText = fso.OpenTextFile(root & "\__init__.py", 1, False).ReadAll
    nodesText = fso.OpenTextFile(root & "\nodes\__init__.py", 1, False).ReadAll
    On Error GoTo 0
    If InStr(initText, "__version__ = ""0.3.1""") = 0 Then Exit Function
    If InStr(nodesText, "KIE_Next_Any_API_Request") > 0 Then Exit Function
    If InStr(nodesText, "refresh_generated_nodes()") = 0 Then Exit Function
    VerifyV031 = True
End Function

Function FindComfyPython(root)
    Dim parent, candidates, item
    FindComfyPython = ""
    parent = fso.GetParentFolderName(root)
    candidates = Array( _
        root & "\.venv\Scripts\python.exe", _
        root & "\venv\Scripts\python.exe", _
        parent & "\python_embeded\python.exe", _
        root & "\python_embeded\python.exe" _
    )
    For Each item In candidates
        If fso.FileExists(CStr(item)) Then
            FindComfyPython = CStr(item)
            Exit Function
        End If
    Next
End Function

Sub EnsureFolder(path)
    Dim parent
    If fso.FolderExists(path) Then Exit Sub
    parent = fso.GetParentFolderName(path)
    If parent <> "" And Not fso.FolderExists(parent) Then EnsureFolder parent
    If Not fso.FolderExists(path) Then fso.CreateFolder path
End Sub

Function TimeStamp()
    Dim d
    d = Now
    TimeStamp = Year(d) & Right("0" & Month(d), 2) & Right("0" & Day(d), 2) & "-" & Right("0" & Hour(d), 2) & Right("0" & Minute(d), 2) & Right("0" & Second(d), 2)
End Function

Function WriteBase64File(data, path)
    Dim xml, node, stream
    WriteBase64File = False
    On Error Resume Next
    Set xml = CreateObject("MSXML2.DOMDocument.6.0")
    Set node = xml.createElement("b64")
    node.DataType = "bin.base64"
    node.Text = data
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 1
    stream.Open
    stream.Write node.nodeTypedValue
    stream.SaveToFile path, 2
    stream.Close
    If Err.Number = 0 Then WriteBase64File = True
    On Error GoTo 0
End Function

Sub WriteRepairReport(path, root, targetPath, moved)
    Dim out
    On Error Resume Next
    Set out = fso.CreateTextFile(path, True)
    out.WriteLine "KIE Nodes Next v0.3.1 repair report"
    out.WriteLine "ComfyUI root: " & root
    out.WriteLine "Installed path: " & targetPath
    out.WriteLine "Quarantined old KIE Next folders: " & moved
    out.WriteLine "Verification: v0.3.1 present; KIE_Next_Any_API_Request absent"
    out.Close
    On Error GoTo 0
End Sub
